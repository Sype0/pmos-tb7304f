# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lenovo-tb7304f
pkgdesc="Lenovo Tab 7 Essential"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-lenovo-tb7304f
	mkbootimg
	mtk-mkimage
	postmarketos-base
	postmarketos-base-downstream
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	tb7304f-mdev.initd
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/tb7304f-mdev.initd \
		"$pkgdir"/etc/init.d/tb7304f-mdev
}

sha512sums=""
