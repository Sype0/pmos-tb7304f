# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-lenovo-tb7304f
pkgdesc="Lenovo Tab 7 Essential"
pkgver=4
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	adwaita-icon-theme
	at-spi2-core
	dbus
	dbus-x11
	dconf
	e2fsprogs-extra
	font-dejavu
	linux-lenovo-tb7304f
	mdev-conf
	mkbootimg
	msm-fb-refresher
	network-manager-applet
	networkmanager
	networkmanager-wifi
	mtk-mkimage
	onboard
	postmarketos-base
	postmarketos-base-downstream
	wpa_supplicant
	xf86-input-evdev
	xf86-video-fbdev
	xfce4
	xfce4-terminal
	xhost
	xinit
	xorg-server
	xset
"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	tb7304f-log.initd
	tb7304f-log.sh
	tb7304f-mdev.initd
	tb7304f-refresh.initd
	tb7304f-resize.initd
	tb7304f-touch.desktop
	tb7304f-touch.sh
	tb7304f-wifi.initd
	tb7304f-wifi.sh
	tb7304f-wmt.tar.gz
	tb7304f-x.initd
	tb7304f-x.sh
"
build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	for service in log mdev refresh resize wifi x; do
		install -Dm755 "$srcdir"/tb7304f-$service.initd \
			"$pkgdir"/etc/init.d/tb7304f-$service
	done
	install -Dm755 "$srcdir"/tb7304f-log.sh "$pkgdir"/usr/bin/tb7304f-log
	install -Dm755 "$srcdir"/tb7304f-x.sh "$pkgdir"/usr/bin/tb7304f-x
	install -Dm755 "$srcdir"/tb7304f-wifi.sh "$pkgdir"/usr/bin/tb7304f-wifi
	install -Dm755 "$srcdir"/tb7304f-touch.sh "$pkgdir"/usr/bin/tb7304f-touch
	install -Dm644 "$srcdir"/tb7304f-touch.desktop \
		"$pkgdir"/etc/xdg/autostart/tb7304f-touch.desktop

	# The programs of the stock firmware that start the WMT driver, with the
	# C library they run on, and the firmware of the chip
	cp -a "$srcdir"/wmt/. "$pkgdir"/
}
sha512sums=""
