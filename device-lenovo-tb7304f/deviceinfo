# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Lenovo Tab 7 Essential"
deviceinfo_manufacturer="Lenovo"
deviceinfo_codename="lenovo-tb7304f"
deviceinfo_year="2017"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_screen_width="600"
deviceinfo_screen_height="1024"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_mtk_label_kernel="KERNEL"
deviceinfo_bootimg_mtk_label_ramdisk="ROOTFS"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
# Stock uses 0x03f88000 (0x44000000), but 0x44400000-0x44500000 is reserved
# for ram_console/pstore, which leaves only 4 MiB for the ramdisk there.
deviceinfo_flash_offset_ramdisk="0x04488000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x0df88000"
deviceinfo_flash_sparse="true"
# boot is 16 MiB and the kernel takes 7.5 MiB of it ("lzma" produces xz)
deviceinfo_initfs_compression="lzma"
