#!/bin/busybox sh
# Init of the boot image for the Lenovo TB-7304F.
#
# The stock kernel has neither devtmpfs nor virtual terminals, which the
# postmarketOS initramfs builds on. This one only does what is needed here:
# fill /dev with mdev, mount the root filesystem from userdata and hand over.
# What happens on the way is saved to pmos-log on the cache partition, where
# the recovery can read it.

/bin/busybox --install -s /bin
export PATH=/bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t tmpfs -o mode=0755,nosuid dev /dev
mknod -m 600 /dev/console c 5 1
mknod -m 666 /dev/null c 1 3
mknod -m 644 /dev/kmsg c 1 11
mdev -s

log() {
	echo "pmos-init: $*" > /dev/kmsg
}

# part <name>: the device node of a partition of the eMMC, by its GPT name
part() {
	for p in /sys/block/mmcblk0/mmcblk0p*; do
		if grep -q "^PARTNAME=$1\$" "$p/uevent"; then
			echo "/dev/${p##*/}"
			return
		fi
	done
}

# save_log <stage>: the kernel log so far, to the cache partition
save_log() {
	[ -b "$CACHE" ] || return
	mkdir -p /c
	mount -t ext4 "$CACHE" /c || return
	mkdir -p /c/pmos-log
	dmesg > "/c/pmos-log/initramfs-$1.txt"
	sync
	umount /c
}

# Without a root filesystem there is nothing to do but go to the recovery:
# the bootloader reads this message from the para partition
fail() {
	log "$*"
	save_log failed
	para=$(part para)
	[ -b "$para" ] && printf 'boot-recovery\0' | dd of="$para" bs=32 count=1 conv=notrunc 2>/dev/null
	sync
	reboot -f
}

i=0
while [ ! -d /sys/block/mmcblk0 ] && [ $i -lt 50 ]; do
	sleep 0.2
	i=$((i + 1))
done
mdev -s

CACHE=$(part cache)
DATA=$(part userdata)
log "cache=$CACHE userdata=$DATA"
save_log start

[ -b "$DATA" ] || fail "no userdata partition"
mkdir -p /sysroot
mount -t ext4 -o rw,noatime "$DATA" /sysroot || fail "could not mount $DATA"
[ -x /sysroot/sbin/init ] || fail "no /sbin/init on $DATA"

log "switching to the root filesystem"
save_log root
mount -o move /dev /sysroot/dev
mount -o move /proc /sysroot/proc
mount -o move /sys /sysroot/sys
exec switch_root /sysroot /sbin/init
